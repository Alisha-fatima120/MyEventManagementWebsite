pipeline {
    agent any

    environment {
        NAMESPACE      = 'event-app'
        BACKEND_IMAGE  = 'event-backend'
        FRONTEND_IMAGE = 'event-frontend'
        TAG            = "${env.BUILD_NUMBER}"
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                    docker build -t ${BACKEND_IMAGE}:${TAG}  ./backend
                    docker build -t ${FRONTEND_IMAGE}:${TAG} ./frontend
                '''
            }
        }

        stage('Test') {
            steps {
                // Syntax check of the backend runs inside the freshly built image
                sh 'docker run --rm ${BACKEND_IMAGE}:${TAG} node --check server.js'
            }
        }

        stage('Load Images into Minikube') {
            steps {
                sh '''
                    minikube image load ${BACKEND_IMAGE}:${TAG}
                    minikube image load ${FRONTEND_IMAGE}:${TAG}
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    for f in k8s/*.yaml; do
                      sed "s/IMAGE_TAG/${TAG}/g" "$f"
                      echo "---"
                    done | kubectl apply -f -
                '''
            }
        }

        stage('Verify Rollout') {
            steps {
                sh '''
                    kubectl -n ${NAMESPACE} rollout status deployment/postgres  --timeout=180s
                    kubectl -n ${NAMESPACE} rollout status deployment/backend   --timeout=180s
                    kubectl -n ${NAMESPACE} rollout status deployment/frontend  --timeout=180s
                    kubectl -n ${NAMESPACE} get pods,svc
                '''
            }
        }
    }

    post {
        success {
            echo "Deployed build #${TAG}. Open the site with: minikube service frontend -n ${NAMESPACE} --url"
        }
        failure {
            echo 'Pipeline failed - rolling back deployments'
            sh '''
                kubectl -n ${NAMESPACE} rollout undo deployment/backend  || true
                kubectl -n ${NAMESPACE} rollout undo deployment/frontend || true
            '''
        }
    }
}
